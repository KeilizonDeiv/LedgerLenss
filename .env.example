# Copy to .env and fill in. Never commit .env.
LL_ENV=dev
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
LL_JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars

LL_DATABASE_URL=postgresql+asyncpg://ledgerlens:ledgerlens@db:5432/ledgerlens
POSTGRES_PASSWORD=ledgerlens

# --- Pick ONE provider -------------------------------------------------
# Local & free (docker compose --profile ollama up):
LL_LLM_PROVIDER=ollama
LL_LLM_MODEL=llama3.1:8b
LL_OLLAMA_BASE_URL=http://ollama:11434

# OpenAI:
# LL_LLM_PROVIDER=openai
# LL_LLM_MODEL=gpt-4o-mini
# LL_OPENAI_API_KEY=sk-...

# Anthropic Claude:
# LL_LLM_PROVIDER=anthropic
# LL_LLM_MODEL=claude-sonnet-4-5
# LL_ANTHROPIC_API_KEY=sk-ant-...

LL_AUTO_APPROVE_LIMIT=5000
LL_MAX_UPLOAD_MB=10
# LL_CORS_ORIGINS=["http://localhost:3000"]
